# ─── Rinde: variables de entorno ───────────────────────────────────────────
# Cargalas en Vercel → Proyecto "rinde" → Settings → Environment Variables.

# Mercado Libre (developers.mercadolibre.com.ar → tu app)
RINDE_MELI_APP_ID=            # "App ID" / Client ID de tu aplicación
RINDE_MELI_SECRET=            # "Clave secreta" / Client Secret
RINDE_MELI_REDIRECT_URI=      # https://TU-DOMINIO/api/auth/callback  (idéntica a la registrada en MeLi)

# Supabase (Project Settings → API)
SUPABASE_URL=                 # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=         # service_role key (¡secreta! nunca en el front)

# IA (console.anthropic.com → API Keys). Modelo: claude-haiku-5-5
ANTHROPIC_API_KEY=

# Email (resend.com → API Keys)
RESEND_API_KEY=
RINDE_EMAIL_FROM=             # opcional. Ej: "Rinde <alertas@tudominio.com>" (requiere dominio verificado en Resend)

# Seguridad (generá valores largos y aleatorios, ver README)
SESSION_SECRET=               # firma de la cookie de sesión
TOKEN_ENC_KEY=                # 64 caracteres hex (32 bytes) para encriptar tokens de MeLi
CRON_SECRET=                  # Vercel lo manda en el cron diario
ADMIN_KEY=                    # clave para entrar a /admin

# Opcional
RINDE_APP_URL=                # https://rinde-orcin.vercel.app (links de los emails)
